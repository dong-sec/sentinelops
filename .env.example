# ============================================================
# SentinelOps Environment Template
# ============================================================

# Project
PROJECT_NAME=sentinelops
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_HOST=backend
BACKEND_PORT=8000

# Frontend
FRONTEND_HOST=frontend
FRONTEND_PORT=3000

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443